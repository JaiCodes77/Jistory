APP_NAME=Jistory
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./data/jistory.db
MAX_IMPORT_SIZE_MB=500

# Gemini is used only for Ask Jistory answers. Imports, search, and embeddings stay local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# local (default, recommended) | gemini | hash
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_LIMIT=8
