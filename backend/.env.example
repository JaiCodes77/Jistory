APP_NAME=Jistory
APP_VERSION=2.0.0
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./data/jistory.db
MAX_IMPORT_SIZE_MB=500

# Gemini is used only for Ask Jistory answers. Imports, search, and embeddings stay local.
# Environment variables take precedence over Settings. The API never returns this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# local (default, recommended) | gemini
# hash is tests-only and must not be used in production.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_LIMIT=8

# Optional default path to Cursor state.vscdb or a transcript folder.
# Jistory never scans $HOME or ~/Library unless you set this or paste a path.
CURSOR_IMPORT_PATH=
